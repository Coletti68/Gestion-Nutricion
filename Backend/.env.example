# Copiar este archivo a `.env` y completar con valores reales.
# NUNCA commitear el `.env` (ya está en .gitignore).

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_clave
DB_NAME=nutricion

# Generar uno largo y aleatorio para producción.
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio
JWT_EXPIRES=6h

# Máximo de pedidos por IP cada 15 minutos (el login tiene su propio límite).
RATE_LIMIT_MAX=600

# Orígenes permitidos para CORS (separados por coma).
CORS_ORIGIN=http://localhost:4200
